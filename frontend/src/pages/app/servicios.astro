---
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout titulo="Servicios" actual="servicios">
  <section class="space-y-6">
    <header>
      <h1 class="text-2xl text-ciruela-oscuro">Servicios</h1>
      <p class="text-sm text-tenue">
        Los precios se guardan en centavos; aquí los capturas en pesos.
      </p>
    </header>

    <p id="aviso" class="hidden rounded-xl bg-salvia/15 px-4 py-3 text-sm text-salvia"></p>
    <p id="error" class="hidden rounded-xl bg-rosa/60 px-4 py-3 text-sm text-ciruela-oscuro"></p>

    <div class="grid gap-5 lg:grid-cols-[1fr_1.2fr]">
      <form class="card space-y-4" id="form-servicio">
        <div class="flex items-center justify-between">
          <h2 class="text-lg text-ciruela-oscuro" id="titulo-form">Nuevo servicio</h2>
          <button class="btn-texto hidden" type="button" id="cancelar">Cancelar</button>
        </div>

        <input type="hidden" id="servicio-id" />

        <div>
          <label class="etiqueta" for="nombre">Nombre</label>
          <input class="campo" id="nombre" required />
        </div>

        <div>
          <label class="etiqueta" for="categoria">Categoría</label>
          <select class="campo" id="categoria">
            <option value="">Sin categoría</option>
          </select>
        </div>

        <div>
          <label class="etiqueta" for="descripcion">Descripción</label>
          <textarea class="campo" id="descripcion" rows="2"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="etiqueta" for="duracion">Duración (min)</label>
            <input class="campo" id="duracion" type="number" min="15" step="15" value="60" required />
          </div>
          <div>
            <label class="etiqueta" for="buffer">Buffer (min)</label>
            <input class="campo" id="buffer" type="number" min="0" step="5" value="0" />
          </div>
        </div>

        <div>
          <label class="etiqueta" for="precio">Precio (MXN)</label>
          <input class="campo" id="precio" type="number" min="0" step="0.01" value="350" required />
        </div>

        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" id="activo" checked /> Activo en la reserva pública
        </label>

        <button class="btn-primario w-full" type="submit">Guardar servicio</button>
      </form>

      <div class="card overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="text-xs uppercase tracking-wide text-tenue">
            <tr>
              <th class="pb-2">Servicio</th>
              <th class="pb-2">Duración</th>
              <th class="pb-2">Precio</th>
              <th class="pb-2"></th>
            </tr>
          </thead>
          <tbody id="tabla-servicios">
            <tr><td colspan="4" class="py-3 text-tenue">Cargando…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <script>
    import { api, type Categoria, type Servicio } from '../../lib/api';
    import { esc, pesos } from '../../lib/formato';
    import { protegerPagina } from '../../lib/sesion';

    const usuario = await protegerPagina();
    const puedeEditar = usuario?.rol === 'admin' || usuario?.rol === 'recepcionista';

    const tabla = document.getElementById('tabla-servicios');
    const error = document.getElementById('error');
    const aviso = document.getElementById('aviso');
    const form = document.getElementById('form-servicio') as HTMLFormElement | null;
    const categoriasSelect = document.getElementById('categoria') as HTMLSelectElement | null;
    const idInput = document.getElementById('servicio-id') as HTMLInputElement | null;
    const tituloForm = document.getElementById('titulo-form');
    const cancelar = document.getElementById('cancelar');

    let servicios: Servicio[] = [];
    let categorias: Categoria[] = [];

    function mensaje(tipo: 'error' | 'aviso', texto: string | null) {
      const el = tipo === 'error' ? error : aviso;
      if (!el) return;
      el.textContent = texto ?? '';
      el.classList.toggle('hidden', !texto);
    }

    function leerFormulario() {
      const valor = (id: string) =>
        (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null)?.value ?? '';
      return {
        nombre: valor('nombre').trim(),
        categoria_id: valor('categoria') || null,
        descripcion: valor('descripcion').trim() || null,
        duracion_min: Number(valor('duracion')),
        buffer_min: Number(valor('buffer')) || 0,
        precio_centavos: Math.round(Number(valor('precio')) * 100),
        activo: (document.getElementById('activo') as HTMLInputElement).checked,
      };
    }

    function limpiarFormulario() {
      form?.reset();
      if (idInput) idInput.value = '';
      if (tituloForm) tituloForm.textContent = 'Nuevo servicio';
      cancelar?.classList.add('hidden');
    }

    function editar(servicio: Servicio) {
      const set = (id: string, valor: string) => {
        const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el) el.value = valor;
      };
      if (idInput) idInput.value = servicio.id;
      set('nombre', servicio.nombre);
      set('categoria', servicio.categoria_id ?? '');
      set('descripcion', servicio.descripcion ?? '');
      set('duracion', String(servicio.duracion_min));
      set('buffer', String(servicio.buffer_min));
      set('precio', (servicio.precio_centavos / 100).toFixed(2));
      const activo = document.getElementById('activo') as HTMLInputElement | null;
      if (activo) activo.checked = servicio.activo;
      if (tituloForm) tituloForm.textContent = 'Editar servicio';
      cancelar?.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function cargar() {
      try {
        const datos = await api<{ servicios: Servicio[]; categorias: Categoria[] }>('/servicios');
        servicios = datos.servicios;
        categorias = datos.categorias;

        if (categoriasSelect) {
          const actual = categoriasSelect.value;
          categoriasSelect.innerHTML =
            '<option value="">Sin categoría</option>' +
            categorias.map((c) => `<option value="${esc(c.id)}">${esc(c.nombre)}</option>`).join('');
          categoriasSelect.value = actual;
        }

        if (!tabla) return;
        const nombreCategoria = new Map(categorias.map((c) => [c.id, c.nombre]));
        tabla.innerHTML = servicios
          .map(
            (s) => `
          <tr class="border-t border-arena/70">
            <td class="py-2">
              <p class="font-medium">${esc(s.nombre)}</p>
              <p class="text-xs text-tenue">${esc(
                nombreCategoria.get(s.categoria_id ?? '') ?? 'Sin categoría'
              )}${s.activo ? '' : ' · inactivo'}</p>
            </td>
            <td class="py-2 text-tenue">${s.duracion_min} min</td>
            <td class="py-2">${esc(pesos(s.precio_centavos))}</td>
            <td class="py-2 text-right">
              <button class="btn-texto" data-editar="${esc(s.id)}" ${puedeEditar ? '' : 'hidden'}>Editar</button>
              <button class="btn-texto text-red-700" data-borrar="${esc(s.id)}" ${
                usuario?.rol === 'admin' ? '' : 'hidden'
              }>Borrar</button>
            </td>
          </tr>`
          )
          .join('');

        tabla.querySelectorAll<HTMLButtonElement>('[data-editar]').forEach((boton) => {
          boton.addEventListener('click', () => {
            const servicio = servicios.find((s) => s.id === boton.dataset.editar);
            if (servicio) editar(servicio);
          });
        });

        tabla.querySelectorAll<HTMLButtonElement>('[data-borrar]').forEach((boton) => {
          boton.addEventListener('click', async () => {
            if (!confirm('¿Borrar este servicio? Si ya tiene citas se desactivará.')) return;
            try {
              const res = await api<{ desactivado?: boolean }>(`/servicios/${boton.dataset.borrar}`, {
                metodo: 'DELETE',
              });
              mensaje('aviso', res.desactivado ? 'Servicio desactivado.' : 'Servicio borrado.');
              await cargar();
            } catch (e) {
              mensaje('error', e instanceof Error ? e.message : 'No se pudo borrar.');
            }
          });
        });
      } catch (e) {
        mensaje('error', e instanceof Error ? e.message : 'No se pudieron cargar los servicios.');
      }
    }

    form?.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      mensaje('error', null);
      const id = idInput?.value;
      try {
        if (id) {
          await api(`/servicios/${id}`, { metodo: 'PUT', cuerpo: leerFormulario() });
          mensaje('aviso', 'Servicio actualizado.');
        } else {
          await api('/servicios', { metodo: 'POST', cuerpo: leerFormulario() });
          mensaje('aviso', 'Servicio creado.');
        }
        limpiarFormulario();
        await cargar();
      } catch (e) {
        mensaje('error', e instanceof Error ? e.message : 'No se pudo guardar.');
      }
    });

    cancelar?.addEventListener('click', limpiarFormulario);

    if (!puedeEditar) form?.setAttribute('hidden', '');
    await cargar();
  </script>
</AppLayout>
