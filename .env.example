# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# --- Base de datos -----------------------------------------------------------
POSTGRES_USER=salon
POSTGRES_PASSWORD=salon
POSTGRES_DB=salon
DATABASE_URL=postgres://salon:salon@localhost:5432/salon

# --- API ---------------------------------------------------------------------
PORT=8000
APP_ENV=development

# Origen público del salón (para cookies y CORS).
APP_ORIGIN=http://localhost:4321

# Zona horaria del salón: define cómo se leen las fechas de agenda y reportes.
APP_TZ=America/Mexico_City

# Secreto para firmar la cookie de sesión (HS256). Mínimo 32 caracteres.
# Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

RUST_LOG=salon_api=info,tower_http=warn

# --- Administradora inicial (se crea al arrancar si no existe) ----------------
ADMIN_EMAIL=admin@salon.mx
ADMIN_PASSWORD=cambia-esta-clave

